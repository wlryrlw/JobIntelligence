# 复制为 .env 使用；LLM_API_KEY 必填。默认适配阿里云百炼，也可换成 Deepseek
LLM_API_KEY=your-universal-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# 分流可选：EMBEDDING_API_KEY 未填回落 LLM_API_KEY；EMBEDDING_BASE_URL 未填跟随 LLM_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# RERANK_API_KEY 未填回落 EMBEDDING_API_KEY
RERANK_API_KEY=
LLM_TIMEOUT=75
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=0
SCHEMA_RECALL_THRESHOLD=0.55
BM25_TOP_K=30
DENSE_TOP_K=30
RRF_TOP_K=40
MAX_SCHEMA_FIELDS=20
MAX_SAVED_MEMORIES=20
MCP_MAX_TOOL_CALLS=3
SHORT_TERM_SUMMARY_ENABLED=true
SHORT_TERM_SUMMARY_TRIGGER_TOKENS=12000
SHORT_TERM_SUMMARY_BATCH_TOKENS=6000
SHORT_TERM_MIN_RECENT_TURNS=5
SESSION_ARCHIVE_ENABLED=false
SESSION_ARCHIVE_PATH=data/session_archive.db
CONTEXT_TABLE_ROW_LIMIT=50
ROUTE_CONTEXT_TURNS=6
