# 复制为 .env 使用；LLM_API_KEY 必填
LLM_API_KEY=your-universal-api-key
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=75
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=0
# 可选的独立 LLM-as-judge 配置；Judge 不回落到主模型，需显式配置并用 python -m eval.judge_runner 调用
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_MODEL=
JUDGE_TIMEOUT=60
JUDGE_TEMPERATURE=0
JUDGE_MAX_RETRIES=1
JUDGE_PROMPT_FILE=eval/prompts/sql_reference_judge.txt
# 交互式问答预算：总流程、单次模型调用和问答内重试次数
QUERY_TIMEOUT_SECONDS=90
QUERY_LLM_TIMEOUT_SECONDS=45
QUERY_MAX_RETRIES=1
MAX_SAVED_MEMORIES=20
SHORT_TERM_SUMMARY_ENABLED=true
SHORT_TERM_SUMMARY_TRIGGER_TOKENS=12000
SHORT_TERM_SUMMARY_BATCH_TOKENS=6000
SHORT_TERM_MIN_RECENT_TURNS=5
SESSION_ARCHIVE_ENABLED=false
SESSION_ARCHIVE_PATH=data/session_archive.db
CONTEXT_TABLE_ROW_LIMIT=50
ROUTE_CONTEXT_TURNS=6

# 岗位 JD RAG（可选；需要使用时将 RAG_ENABLED 改为 true）
# RAG_API_KEY 留空，填写阿里百炼 API Key，例如 sk-...
RAG_ENABLED=false
RAG_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_RERANK_ENABLED=false
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=offeragent_job_jd
RAG_DENSE_TOP_K=50
RAG_BM25_TOP_K=50
RAG_RRF_K=60
RAG_RERANK_TOP_K=8
RAG_INDEX_STATE_PATH=../data/rag/index_state.json
