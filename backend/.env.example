# 复制为 .env 使用；LLM_API_KEY 必填
LLM_API_KEY=your-universal-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT=75
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=0
# 可选的独立 LLM-as-judge 配置；Judge 不回落到主模型，需显式配置并用 python -m eval.judge_runner 调用
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_MODEL=
JUDGE_TIMEOUT=60
JUDGE_TEMPERATURE=0
JUDGE_MAX_RETRIES=1
JUDGE_PROMPT_FILE=eval/prompts/sql_reference_judge.txt
# 交互式问答预算：总流程、单次模型调用和问答内重试次数
QUERY_TIMEOUT_SECONDS=60
QUERY_LLM_TIMEOUT_SECONDS=20
QUERY_MAX_RETRIES=1
MAX_SAVED_MEMORIES=20
SHORT_TERM_SUMMARY_ENABLED=true
SHORT_TERM_SUMMARY_TRIGGER_TOKENS=12000
SHORT_TERM_SUMMARY_BATCH_TOKENS=6000
SHORT_TERM_MIN_RECENT_TURNS=5
SESSION_ARCHIVE_ENABLED=false
SESSION_ARCHIVE_PATH=data/session_archive.db
CONTEXT_TABLE_ROW_LIMIT=50
ROUTE_CONTEXT_TURNS=6
